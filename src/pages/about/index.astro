---
import { Button, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About'  {headings}  comment>
  <section class="profile-section not-prose" aria-labelledby="profile-title">
    <h2 id="profile-title">Developer</h2>

    <div class="profile-layout">
      <div class="profile-photo">
        <img
          src='/images/avatar.png'
          alt="ShanMaoy 的头像"
          width={600}
          height={600}
        />
      </div>

      <div class="profile-description">
        <p>
          I'm a first-year Computer Science and Technology student at CQUE.
        </p>
        <p>
          I'm interested in software engineering, computer systems, and exploring how technology works under the hood. I enjoy learning new things, experimenting with different technologies, and turning ideas into practical projects.
        </p>
        <p>
          This blog is my personal space to document what I learn, share my projects and ideas, and personal reflections.
        </p>
      </div>
    </div>
  </section>
  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/ShanMaoy',
        text: 'followers',
        api: 'github/ShanMaoy'
      },
      {
        platform: 'X',
        icon: 'x',
        link: 'https://x.com/ShanMaoy',
        text: 'followers',
        api: 'twitter/ShanMaoy'
      },
      {
        platform: 'bilibili',
        icon: 'bilibili',
        link: 'https://space.bilibili.com/474291763',
        text: 'followers',
        api: 'bilibili/474291763'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/profiles/76561199106930966/',
        text: 'games',
        api: 'steamgames/76561199106930966'
      }
    ]}
  />

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Current support tools as follow:</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'WebStorm',
        description: 'IDE',
        href: 'https://www.jetbrains.com/webstorm/',
        icon: import('@/assets/tools/webstorm.svg?raw')
      },
      {
        name: 'CLion',
        description: 'IDE',
        href: 'https://www.jetbrains.com/clion/',
        icon: import('@/assets/tools/clion.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: 'Framework Laptop 16',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/*education*/}
  <h2 id='education'>Education</h2>
  <Timeline
    events={[
      {
        date: '2026-9-10',
        content:
          '<a href="https://www.cque.edu.cn/" target="_blank">Chongqing University Of Education</a>'
      },
    ]}
  />
  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>This is already the umpteenth blog I've tinkered with.</p>
  <p>A long time ago, I used WordPress, but eventually found it a little too bloated for the kind of content I wanted to share. After starting university, I decided to build my own blog from scratch. Unfortunately, my design skills weren't quite up to the task, and after several attempts, I still couldn't get the look I wanted.</p>
  <p>Then one day, I stumbled upon a blog using this theme. I loved its design at first sight, and it felt just right for me. So, here I am, starting another round of tinkering.</p>
</PageLayout>

<style>
  #profile-title,
  #social-networks,
  #tools,
  #education,
  #about-blog {
    font-weight: 430;
  }

  .profile-section {
    margin-bottom: 1rem;
  }

  .profile-section h2 {
    margin: 0 0 1.5rem;
    color: hsl(var(--foreground));
    font-size: 1.75rem;
  }

  .profile-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
  }

  .profile-photo {
    width: 100%;
    max-width: 280px;
    margin-inline: auto;
  }

  .profile-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
  }

  .photo-caption {
    margin: 0.75rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    font-style: italic;
    text-align: center;
  }

  .profile-description {
    min-width: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.85;
  }

  .profile-description > p {
    margin: 0 0 1.5rem;
  }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .profile-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .profile-socials a:hover {
    color: hsl(var(--primary));
  }

  @media (min-width: 768px) {
    .profile-layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }
</style>
